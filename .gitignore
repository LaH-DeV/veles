veles
veles.exe
*.exe*
*.ll
# the codegen goldens are the one kind of .ll that belongs in the tree
!codegen/llvm/golden/**/*.ll

**/testdata/*
# the conformance cases (plan A4) are sources, not generated data
!sema/testdata/conform/
# the list of std functions marked `const fun` (std/const_test.go) is a golden
!std/testdata/const-functions.txt


node_modules
**/.vitepress/cache
**/.vitepress/dist

# --- the package system (D138, D139) -------------------------------------------
# a VELES_HOME that is a relative path, or an unset HOME in CI, puts the module
# cache (downloaded packages, temporary checkouts) next to the project
.veles/
# `veles build` at a workspace root writes each program to bin/<name>
bin/
# secrets: reviewer signing keys (`veles attest keygen`) and environment files (the registry token lives in
# ~/.veles/token or $VELES_TOKEN, outside any project).
# Statements (attestations/*.attest), veles.sum and vendor/ are meant to be committed.
*.key
.env
.env.*
!.env.example

# --- editors and operating systems ----------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~
