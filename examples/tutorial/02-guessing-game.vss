use io { println, readLine }, random

fun main() {
  println("Guess the number!")

  val secret = random.range(0, 101)

  loop :game {
    println("Please input your guess.")

    val guess = when (val input = readLine()) {
      is string => i64.parse(input.trim())
      else      => continue
    }

    if (guess !is i64) continue
    println("You guessed: $guess")

    when (guess.compareTo(secret)) {
      Ordering.Less    => println("Too small!")
      Ordering.Greater => println("Too big!")
      Ordering.Equal   => {
        println("You win!")
        break game
      }
    }
  }
}
