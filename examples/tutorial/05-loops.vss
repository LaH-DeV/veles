use io { println }

fun main() {
  var count = 0
  loop :countingUp {
    println("count = $count")
    var remaining = 10
    loop {
      println("remaining = $remaining")
      if (remaining == 9) break
      if (count == 2) break countingUp
      remaining -= 1
    }
    count += 1
  }
  println("End count = $count")
}
