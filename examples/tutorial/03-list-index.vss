use io { eprintln, println, readLine }
use os

fun main() {
  var list = [1, 2, 3, 4, 5]

  println("Please enter an array index.")

  val index = when (val input = readLine()) {
    is string => i64.parse(input.trim())
    else      => {
      eprintln("Failed to read line")
      os.exit(1)
    }
  }

  if (index !is i64) {
    eprintln("Index entered was not a number")
    os.exit(1)
  }

  when (val element = list.at(index)) {
    is i64 => println("The value of the element at index $index is: $element")
    else   => eprintln("Index out of bounds")
  }
}
