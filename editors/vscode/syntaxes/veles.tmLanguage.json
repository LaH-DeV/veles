{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Veles",
  "scopeName": "source.veles",
  "fileTypes": ["vs"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#use" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#effects" },
    { "include": "#literals" },
    { "include": "#templateTag" },
    { "include": "#textblocks" },
    { "include": "#regex" },
    { "include": "#rawstrings" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#types" },
    { "include": "#calls" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.veles",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.veles",
          "match": "//.*$"
        },
        {
          "name": "comment.block.documentation.veles",
          "begin": "/\\*\\*(?!/)",
          "end": "\\*/",
          "patterns": [{ "include": "#comments" }]
        },
        {
          "name": "comment.block.veles",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [{ "include": "#comments" }]
        }
      ]
    },
    "attributes": {
      "name": "meta.attribute.veles",
      "match": "(@)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "punctuation.definition.attribute.veles" },
        "2": { "name": "entity.other.attribute-name.veles" }
      }
    },
    "use": {
      "name": "meta.use.veles",
      "begin": "\\b(use)\\b",
      "beginCaptures": { "1": { "name": "keyword.control.import.veles" } },
      "end": "$",
      "patterns": [
        {
          "comment": "use m { name, other as alias } (D85): the names are members, not modules",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            { "name": "keyword.control.import.veles", "match": "\\bas\\b" },
            {
              "name": "entity.name.function.veles",
              "match": "[A-Za-z_][A-Za-z0-9_]*"
            },
            { "include": "#punctuation" }
          ]
        },
        { "name": "keyword.control.import.veles", "match": "\\bas\\b" },
        {
          "comment": "use m extend / use m { A } extend { f } (D185): the clause that brings extension functions",
          "name": "keyword.control.import.veles",
          "match": "\\bextend\\b"
        },
        {
          "name": "entity.name.namespace.veles",
          "match": "[A-Za-z_][A-Za-z0-9_]*"
        },
        { "include": "#punctuation" }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "comment": "fun name(",
          "match": "\\b(public\\s+|private\\s+|internal\\s+)?(override\\s+)?(unsafe\\s+)?(static\\s+)?(fun)\\s+(?!on\\s+[A-Za-z(])([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.veles" },
            "2": { "name": "storage.modifier.veles" },
            "3": { "name": "storage.modifier.veles" },
            "4": { "name": "storage.modifier.veles" },
            "5": { "name": "storage.type.function.veles" },
            "6": { "name": "entity.name.function.veles" }
          }
        },
        {
          "comment": "annotation Name(params) on targets for Traits = wrapper (D174, D176): `on` and `for` are words of the declaration, to the end of the line",
          "begin": "\\b(?:(public|internal)\\s+)?(annotation)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "beginCaptures": {
            "1": { "name": "storage.modifier.veles" },
            "2": { "name": "storage.type.veles" },
            "3": { "name": "entity.name.type.veles" }
          },
          "end": "$",
          "patterns": [
            { "include": "#comments" },
            {
              "comment": "`on field, enumMember`; a parameter named `on` is followed by `:`",
              "name": "keyword.other.on.veles",
              "match": "\\bon\\b(?=\\s+[A-Za-z])"
            },
            {
              "comment": "the targets after `on` (D174, D178): words of the declaration, as `fun` and `struct` are",
              "name": "keyword.other.target.veles",
              "match": "(?<=\\bon\\s|,\\s|\\bon\\s\\s|,)\\b(field|struct|fun|trait|enum|enumMember|variant|test|suite)\\b(?!\\s*:)"
            },
            { "name": "keyword.other.for.veles", "match": "\\bfor\\b" },
            { "include": "#literals" },
            { "include": "#strings" },
            { "include": "#types" },
            { "include": "#operators" },
            { "include": "#punctuation" }
          ]
        },
        {
          "comment": "struct / trait / sealed trait / error / enum / annotation (D174; contextual: a keyword only before a type name)",
          "match": "\\b(public\\s+)?(extern\\s+)?(sealed\\s+)?(struct|trait|error|enum|union|annotation)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.veles" },
            "2": { "name": "storage.modifier.veles" },
            "3": { "name": "storage.modifier.veles" },
            "4": { "name": "storage.type.veles" },
            "5": { "name": "entity.name.type.veles" }
          }
        },
        {
          "comment": "implement Trait for Type — or, with no body, `implement Codable` (D58: derived), which ends with the line",
          "begin": "\\b(implement)\\b",
          "beginCaptures": { "1": { "name": "storage.type.impl.veles" } },
          "end": "(?=\\{)|$",
          "patterns": [
            { "name": "keyword.other.for.veles", "match": "\\bfor\\b" },
            { "include": "#types" },
            { "include": "#punctuation" }
          ]
        },
        {
          "comment": "extend<T> Type { ... } and extend<T> Type with fun f() … (D173); contextual keyword at declaration position, optionally after public/internal",
          "begin": "^\\s*(?:(public|internal)\\s+)?(extend)\\b(?=\\s*[<A-Za-z_*(])",
          "beginCaptures": {
            "1": { "name": "storage.modifier.veles" },
            "2": { "name": "storage.type.impl.veles" }
          },
          "end": "(\\bwith\\b)|(?=\\{)|$",
          "endCaptures": { "1": { "name": "keyword.other.with.veles" } },
          "patterns": [{ "include": "#types" }, { "include": "#punctuation" }]
        },
        {
          "comment": "init { }  (contextual: only directly before a brace)",
          "match": "^\\s*(init)\\b(?=\\s*\\{)",
          "captures": {
            "1": { "name": "storage.type.init.veles" }
          }
        },
        {
          "comment": "test label \"name\" { } (D170): the label is a name tests can be listed by",
          "match": "^\\s*(test)\\s+(?!fun\\b)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\")",
          "captures": {
            "1": {
              "name": "storage.type.test.veles"
            },
            "2": {
              "name": "entity.name.label.test.veles"
            }
          }
        },
        {
          "comment": "test \"name\" { }, suite \"name\" { }  and  test fun  (D78; contextual: only before a string or 'fun')",
          "match": "^\\s*(test|suite)\\b(?=\\s*(\"|fun\\b))",
          "captures": {
            "1": { "name": "storage.type.test.veles" }
          }
        },
        {
          "comment": "type Item = ...  (associated type)",
          "match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.veles" },
            "2": { "name": "entity.name.type.veles" }
          }
        },
        {
          "comment": "val / var / const binding",
          "match": "\\b(public\\s+)?(val|var|const)\\s+(?!(?:fun|struct|compact|extern)\\b)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.veles" },
            "2": { "name": "storage.type.veles" },
            "3": { "name": "variable.other.declaration.veles" }
          }
        },
        {
          "comment": "loop :label",
          "match": "\\b(loop)\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.loop.veles" },
            "2": { "name": "punctuation.separator.label.veles" },
            "3": { "name": "entity.name.label.veles" }
          }
        },
        {
          "comment": "break/continue label",
          "match": "\\b(break|continue)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.loop.veles" },
            "2": { "name": "entity.name.label.veles" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.veles",
          "match": "\\b(if|else|when|is)\\b"
        },
        {
          "comment": "inline loop (f in T.fields) { } (contextual: only directly before `loop`, D174)",
          "name": "keyword.control.loop.veles",
          "match": "(?<![.\\w])inline\\b(?=\\s+loop\\b)"
        },
        {
          "comment": "indirect struct / inline struct / indirect sealed trait: where a variant is stored (contextual, D198)",
          "name": "storage.modifier.veles",
          "match": "(?<![.\\w])(indirect|inline)\\b(?=\\s+(compact\\s+)?(struct|sealed)\\b)"
        },
        {
          "comment": "compact struct: the compiler places the fields (contextual, D215)",
          "name": "storage.modifier.veles",
          "match": "(?<![.\\w])compact\\b(?=\\s+(extern\\s+)?struct\\b)"
        },
        {
          "comment": "fun on T(A): R, a receiver function type (contextual: only directly after `fun`, D207)",
          "match": "\\b(fun)\\s+(on)\\b(?=\\s+[A-Za-z(])",
          "captures": {
            "1": { "name": "storage.type.function.veles" },
            "2": { "name": "keyword.other.on.veles" }
          }
        },
        {
          "name": "keyword.control.loop.veles",
          "match": "\\b(loop|break|continue|in)\\b"
        },
        {
          "name": "keyword.control.flow.veles",
          "match": "\\b(return|throw|try|do|catch|with)\\b"
        },
        {
          "name": "keyword.control.concurrency.veles",
          "match": "\\b(async|await|scope|gather|race|cede)\\b"
        },
        {
          "comment": "select { } (contextual: only directly before a brace, D169)",
          "name": "keyword.control.concurrency.veles",
          "match": "(?<![.\\w])select\\b(?=\\s*\\{)"
        },
        {
          "name": "storage.modifier.veles",
          "match": "\\b(public|private|internal|protected|override|unsafe|extern|mut|static|sealed|sendable)\\b"
        },
        {
          "name": "storage.modifier.veles",
          "match": "\\btemplate\\b(?=\\s+(?:const\\s+)?fun\\b)"
        },
        {
          "name": "storage.modifier.veles",
          "comment": "a lazy parameter (D90), or a lazy val built on its first read (D210)",
          "match": "\\b(lazy)\\b(?=\\s+([A-Za-z_][A-Za-z0-9_]*\\s*:|(val|var|const)\\b))"
        },
        {
          "name": "storage.type.veles",
          "match": "\\b(fun|struct|trait|implement|enum|val|var|const|type)\\b"
        },
        {
          "name": "keyword.operator.expression.veles",
          "match": "\\b(as|raw|for)\\b"
        },
        {
          "name": "keyword.operator.expression.veles",
          "match": "\\b(implements)\\b"
        },
        { "name": "variable.language.this.veles", "match": "\\b(this)\\b" },
        { "name": "support.type.self.veles", "match": "\\b(This)\\b" },
        {
          "name": "invalid.illegal.reserved.veles",
          "match": "\\b(self|match|defer|go|yield|where|super|catch|interface|class|while|do|finally|import|package|module|let)\\b"
        }
      ]
    },
    "effects": {
      "name": "keyword.other.effect.veles",
      "match": "\\b(throws|suspends)\\b"
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.language.boolean.veles",
          "match": "\\b(true|false)\\b"
        },
        { "name": "constant.language.null.veles", "match": "\\b(null)\\b" },
        {
          "name": "constant.numeric.hex.veles",
          "match": "\\b0[xX][0-9a-fA-F_]+([iu](8|16|32|64))?\\b"
        },
        {
          "name": "constant.numeric.binary.veles",
          "match": "\\b0[bB][01_]+([iu](8|16|32|64))?\\b"
        },
        {
          "name": "constant.numeric.float.veles",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?(f32|f64)?\\b"
        },
        {
          "name": "constant.numeric.float.veles",
          "match": "\\b[0-9][0-9_]*[eE][+-]?[0-9]+(f32|f64)?\\b"
        },
        {
          "name": "constant.numeric.integer.veles",
          "match": "\\b[0-9][0-9_]*([iu](8|16|32|64)|f32|f64)?\\b"
        }
      ]
    },
    "templateTag": {
      "comment": "`sql\"…\"`, `db.sql\"…\"` (D129): the name written right before a string is the template function; the string that follows is a string",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\")",
      "name": "entity.name.function.call.veles"
    },
    "textblocks": {
      "comment": "D172: a text block, `\"\"\"` on its own line to `\"\"\"`; escapes and interpolation work as in a string",
      "name": "string.quoted.triple.veles",
      "begin": "\"\"\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.veles" }
      },
      "end": "\"\"\"",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.veles" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.veles",
          "match": "\\\\(u\\{[0-9a-fA-F]+\\}|[nrt0\\\\\"'$])"
        },
        {
          "name": "meta.interpolation.veles",
          "begin": "\\$\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.begin.veles"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.end.veles"
            }
          },
          "contentName": "meta.embedded.line.veles",
          "patterns": [{ "include": "$self" }]
        },
        {
          "name": "meta.interpolation.veles meta.embedded.line.veles",
          "match": "(\\$)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.template-expression.begin.veles"
            },
            "2": { "name": "variable.other.readwrite.veles" }
          }
        }
      ]
    },
    "rawstrings": {
      "comment": "D172: a backtick string is raw — no escapes, no interpolation — and may span lines",
      "name": "string.quoted.other.raw.veles",
      "begin": "`",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.veles" }
      },
      "end": "`",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.veles" }
      }
    },
    "regex": {
      "comment": "D182: /pattern/flags where a value may start, i.e. not right after a name, a number, a string, ')', ']' or '}' (the compiler's lexer decides by the previous token; this is the usual editor approximation). Inside, the pattern's own parts are coloured.",
      "name": "string.regexp.veles",
      "begin": "(?:(?<=\\b(?:return|in|is|else|try|throw|await|if|when)\\s)|(?<![\\w)\\]}'\"`/*])(?<![\\w)\\]}]\\s))(/)(?![/*\\s])",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.string.begin.veles"
        }
      },
      "end": "(/)([imsxu]*)|(?=$)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.veles"
        },
        "2": {
          "name": "keyword.other.flags.regexp.veles"
        }
      },
      "patterns": [
        {
          "name": "constant.other.character-class.escape.regexp.veles",
          "match": "\\\\[dDwWsS]"
        },
        {
          "name": "keyword.control.anchor.regexp.veles",
          "match": "\\\\[bBAz]"
        },
        {
          "name": "constant.character.escape.regexp.veles",
          "match": "\\\\(?:[dDwWsS]|[bBAz]|x\\{[0-9a-fA-F]+\\}|x[0-9a-fA-F]{2}|.)"
        },
        {
          "name": "constant.other.character-class.set.regexp.veles",
          "begin": "\\[\\^?",
          "end": "\\]",
          "patterns": [
            {
              "name": "constant.other.character-class.posix.regexp.veles",
              "match": "\\[:\\^?[a-z]+:\\]"
            },
            {
              "name": "constant.other.character-class.escape.regexp.veles",
              "match": "\\\\[dDwWsS]"
            },
            {
              "name": "constant.character.escape.regexp.veles",
              "match": "\\\\(?:[dDwWsS]|[bBAz]|x\\{[0-9a-fA-F]+\\}|x[0-9a-fA-F]{2}|.)"
            },
            {
              "name": "punctuation.separator.range.regexp.veles",
              "match": "(?<=[^\\[^])-(?=[^\\]])"
            }
          ]
        },
        {
          "name": "punctuation.definition.group.regexp.veles",
          "match": "\\(\\?(?:<[A-Za-z_][A-Za-z0-9_]*>|P<[A-Za-z_][A-Za-z0-9_]*>|[imsx-]*:|[imsx-]+(?=\\)))|\\(|\\)"
        },
        {
          "name": "keyword.operator.quantifier.regexp.veles",
          "match": "[*+?]\\??|\\{\\d+(?:,\\d*)?\\}\\??"
        },
        {
          "name": "keyword.operator.or.regexp.veles",
          "match": "\\|"
        },
        {
          "name": "keyword.control.anchor.regexp.veles",
          "match": "[\\^$]"
        },
        {
          "name": "constant.other.character-class.any.regexp.veles",
          "match": "\\."
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.veles",
      "begin": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.veles" }
      },
      "end": "\"",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.veles" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.veles",
          "match": "\\\\(u\\{[0-9a-fA-F]+\\}|[nrt0\\\\\"'$])"
        },
        {
          "comment": "`${expr}` — contentName meta.embedded makes themes drop the string colour inside, so the expression is coloured as code",
          "name": "meta.interpolation.veles",
          "begin": "\\$\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.begin.veles"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.end.veles"
            }
          },
          "contentName": "meta.embedded.line.veles",
          "patterns": [{ "include": "$self" }]
        },
        {
          "comment": "`$name`",
          "name": "meta.interpolation.veles meta.embedded.line.veles",
          "match": "(\\$)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.template-expression.begin.veles"
            },
            "2": { "name": "variable.other.readwrite.veles" }
          }
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.veles",
      "match": "'(\\\\(u\\{[0-9a-fA-F]+\\}|[nrt0\\\\'\"])|[^'\\\\])'",
      "captures": { "1": { "name": "constant.character.escape.veles" } }
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.veles",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|string|char)\\b"
        },
        {
          "name": "support.type.collection.veles",
          "match": "\\b(List|MutableList|Array|Map|MutableMap|Set|MutableSet|Channel|Range|Option|Result|Task|Iterator|Iterable|Closeable|Mutex|Atomic|Panic|Sendable)\\b"
        },
        {
          "name": "support.function.prelude.veles",
          "match": "\\b(Some|None|Ok|Err|sleep)\\b"
        },
        {
          "comment": "Capitalised identifiers are types or variants",
          "name": "entity.name.type.veles",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "calls": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\(|<[A-Za-z_][A-Za-z0-9_, <>?*]*>\\()",
      "captures": { "1": { "name": "entity.name.function.call.veles" } }
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.veles", "match": "=>" },
        { "name": "keyword.operator.range.veles", "match": "\\.\\.<|\\.\\." },
        {
          "name": "keyword.operator.nullable.veles",
          "match": "\\?\\?|\\?:|\\?!|\\?\\.|\\?"
        },
        { "name": "keyword.operator.wrapping.veles", "match": "[+\\-*]%" },
        {
          "name": "keyword.operator.comparison.veles",
          "match": "==|!=|<=|>=|<|>"
        },
        { "name": "keyword.operator.logical.veles", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.assignment.veles", "match": "[+\\-*/%]?=" },
        { "name": "keyword.operator.arithmetic.veles", "match": "[+\\-*/%]" },
        { "name": "keyword.operator.union.veles", "match": "\\|" },
        { "name": "keyword.operator.address.veles", "match": "&" },
        { "name": "punctuation.accessor.assoc.veles", "match": "::" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.comma.veles", "match": "," },
        { "name": "punctuation.separator.colon.veles", "match": ":" },
        { "name": "punctuation.terminator.veles", "match": ";" },
        { "name": "punctuation.accessor.veles", "match": "\\." },
        { "name": "punctuation.section.block.begin.veles", "match": "\\{" },
        { "name": "punctuation.section.block.end.veles", "match": "\\}" },
        { "name": "punctuation.section.brackets.begin.veles", "match": "\\[" },
