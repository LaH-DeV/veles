use io { println }

fun mirror(name: string, delay: Duration): string {
  await sleep(delay)
  return name
}

fun work(x: i64): i64 {
  await sleep(Duration.millis(10))
  return x * x
}

fun selected(): string => select {
  async mirror("eu", Duration.millis(30)) => "EU"
  async mirror("us", Duration.millis(10)) => "US"
}

fun fastest(): string => race {
  async mirror("eu", Duration.millis(30))
  async mirror("us", Duration.millis(10))
  await sleep(Duration.millis(50))
  async {
    await sleep(Duration.millis(20))
    return "Done"
  }
}

fun inScope(): i64 => scope {
  val a = async work(1)
  println("Doing some work in the scope...")
  val b = async work(2)
  println("Doing some work in the scope...")
  val (x, y) = awaitAll(a, b)
  return x + y
}

fun withGather(): i64 {
  val (r1, r2, r3) = gather {
    async work(1)
    async work(2)
    async work(5)
  }
  return (r1 ?? 0) + (r2 ?? 0) + (r3 ?? 0)
}
